[Unit]
Description=GamePulse: new Steam news items
StartLimitIntervalSec=30min
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=%h/projects/gamepulse
# The project's own environment, created once with `uv sync`.
ExecStart=%h/projects/gamepulse/.venv/bin/gamepulse news
TimeoutStartSec=15min
# A catch-up run can start before the network is up; try again shortly.
Restart=on-failure
RestartSec=2min
